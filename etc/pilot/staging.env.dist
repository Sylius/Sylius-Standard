# QA Companion pilot -- staging host configuration.
#
# Copy to etc/pilot/staging.env on the host, fill in, and `chmod 600` it. That file is
# gitignored and must never be committed: it holds this environment's secrets.
#
#     cp etc/pilot/staging.env.dist etc/pilot/staging.env && chmod 600 etc/pilot/staging.env
#
# Generate the two random values with `openssl rand -hex 32`.

# The base URL the platform will store for this environment, and the URL a person opens.
# Must match the Host header the shop is reached by: Sylius resolves its channel from it.
# With no domain to hand, an address-derived name works with no DNS setup at all:
# http://203-0-113-9.nip.io resolves to 203.0.113.9.
PILOT_BASE_URL=http://REPLACE-ME
# Host part of the URL above, without the scheme and without a port.
SYLIUS_FIXTURES_HOSTNAME=REPLACE-ME

# Symfony's application secret. Random, and specific to this host.
APP_SECRET=REPLACE-ME
# MySQL's root password. Nothing outside the host's Docker network can reach the database
# -- port 3306 is not published -- but the value still has to be a real one.
MYSQL_ROOT_PASSWORD=REPLACE-ME

# The admin account. Sylius's own fixtures create sylius@example.com with the password
# "sylius", which is public knowledge, so the deploy script changes it to this one after
# every fixture load. Leave PILOT_ADMIN_PASSWORD empty to skip that and keep the default --
# only sensible if nothing but your own address can reach the host.
PILOT_ADMIN_EMAIL=sylius@example.com
PILOT_ADMIN_PASSWORD=REPLACE-ME

# The user files created inside the containers belong to on the host. `id -u`:`id -g` of the
# account that owns the checkout.
DOCKER_USER=1000:1000
