{% set order = hookable_metadata.context.resource %}

<div class="py-3">
        <div class="font-weight-bold">
            <h3>{{ 'sylius.ui.note.label'|trans }}</h3>
            <textarea class="form-control" rows="3" placeholder="{{ 'sylius.ui.note.placeholder'|trans }}" disabled>{{ order.note }}</textarea>
        </div>
        <div class="d-grid gap-2 mb-3">
            <a href="{{ path('sylius_admin_order_update', { id: order.id }) }}" class="btn">
                {{ ux_icon('tabler:pencil') }}
                {{ 'sylius.ui.note.edit_note'|trans }}
            </a>
        </div>
</div>
