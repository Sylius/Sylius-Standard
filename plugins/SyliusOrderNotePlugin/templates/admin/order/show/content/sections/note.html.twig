{% set form = this.form %}
<div class="card mb-3" {{ attributes }} data-test-order-note-section>
    <div class="card-header">
        <div class="card-title">{{ 'sylius_order_note.ui.order_note'|trans }}</div>
    </div>
    <div class="card-body">
        {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.note) }}
        <p class="text-muted">{{ 'sylius_order_note.ui.admin_only_hint'|trans }}</p>
        <div class="d-flex justify-content-between">
            {{ form_widget(form.save, {'attr': {'class': 'btn btn-primary'}}) }}
            {% if order.orderNote is not null %}
                {{ form_widget(form.delete, {'attr': {'class': 'btn btn-outline-danger', 'formnovalidate': 'formnovalidate'}}) }}
            {% else %}
                {% do form.delete.setRendered() %}
            {% endif %}
        </div>
        {{ form_end(form) }}
    </div>
</div>
