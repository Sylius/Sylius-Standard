{
    "name": "piotrekpilat/sylius-order-note-plugin",
    "type": "sylius-plugin",
    "description": "Sylius plugin to add admin-only order notes functionality.",
    "license": "MIT",
    "authors": [
        {
            "name": "Piotr Piłat",
            "homepage": "https://github.com/piotrekpilat"
        }
    ],
    "require": {
        "php": "^8.3",
        "sylius/sylius": "^2.0 || ^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SyliusOrderNotePlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SyliusOrderNotePlugin\\Tests\\": "tests/"
        }
    }
}
